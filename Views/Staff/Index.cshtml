@model List<StaffMember>
@{
    ViewData["Title"] = "Staff Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Staff Members</h4>
    <a asp-controller="Staff" asp-action="Create" class="btn btn-success">+ Add Staff Member</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<table class="table table-bordered table-striped bg-white">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Position</th>
            <th>Unit</th>
            <th style="width: 160px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No staff members yet.</td>
            </tr>
        }
        else
        {
            @foreach (var staff in Model)
            {
                <tr>
                    <td>@staff.StaffId</td>
                    <td>@staff.FullName</td>
                    <td>@staff.Email</td>
                    <td>@staff.Position</td>
                    <td>@staff.Unit</td>
                    <td>
                        <a asp-controller="Staff" asp-action="Edit" asp-route-id="@staff.StaffId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="Staff" asp-action="Delete" asp-route-id="@staff.StaffId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
